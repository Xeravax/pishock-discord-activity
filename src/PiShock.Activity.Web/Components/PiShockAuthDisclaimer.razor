@* Explicit notice: session auth token (not API key), encrypted at rest. Shown before / during PiShock linking. *@
<aside class="pishock-auth-disclaimer@(Compact ? " pishock-auth-disclaimer--compact" : "")"
       role="note"
       aria-label="PiShock authentication disclaimer">
    <div class="pishock-auth-disclaimer__eyebrow">Authentication disclaimer</div>
    <p class="pishock-auth-disclaimer__lead">
        This application <strong>will request an authentication token</strong> from PiShock when you
        link your account.
    </p>
    <ul class="pishock-auth-disclaimer__list">
        <li>
            It uses a <strong>PiShock login / session authentication token</strong>, not a classic
            PiShock <strong>API key</strong>, for your account.
        </li>
        <li>
            It will <strong>not</strong> ask for or store an API key for you. Other people's
            devices are only controllable when <strong>
                those users have logged in with their own
                PiShock accounts
            </strong> in this activity (their own tokens / shares).
        </li>
        <li>
            Authentication tokens are <strong>encrypted in the database</strong> (AES-256-GCM) and are
            never sent to other users' browsers.
        </li>
    </ul>
</aside>

@code {
    /// <summary>Slightly denser layout for compact panels.</summary>
    [Parameter] public bool Compact { get; set; }
}

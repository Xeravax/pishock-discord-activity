<div class="auth-boot" role="dialog" aria-modal="true" aria-labelledby="link-confirm-title">
    <div class="auth-boot__glow" aria-hidden="true"></div>
    <div class="auth-boot__panel auth-boot__panel--wide">
        <div class="auth-boot__mark" aria-hidden="true">
            <i class="q-icon mdi mdi-account-check auth-boot__bolt"></i>
        </div>
        <h1 class="auth-boot__brand auth-boot__brand-row">
            <span class="auth-boot__brand-name">Pi<span>Shock</span></span>
            <AppVersionBadge />
        </h1>
        <p class="auth-boot__sub">Confirm account</p>

        <h2 id="link-confirm-title" class="auth-boot__heading">Is this your PiShock account?</h2>
        <p class="auth-boot__hint">
            PiShock confirmed a successful login. Link it to
            <strong class="text-grey-3">@DiscordName</strong> only if this is you.
        </p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-boot__error">
                <div class="auth-boot__error-title">Couldn’t link</div>
                <p>@Error</p>
            </div>
        }

        <div class="auth-boot__account">
            <div class="auth-boot__account-label">PiShock account</div>
            <div class="auth-boot__account-id">User ID @PishockUserId</div>
            @if (HubNames.Count > 0)
            {
                <div class="auth-boot__account-hubs">Hubs: @string.Join(", ", HubNames)</div>
            }
            else
            {
                <div class="auth-boot__account-hubs">
                    Hub names unavailable — User ID is enough to verify this is you.
                </div>
            }
        </div>

        <PiShockAuthDisclaimer Compact="true" />

        <p class="auth-boot__caption">
            Only confirm if this is your account. Cancel discards the login and does not link anything.
        </p>

        <div class="auth-boot__actions">
            <QBtn Class="text-grey-4 bg-dark q-btn--outline q-btn--rectangle q-btn--actionable"
                  Disabled="Busy" OnClick="OnCancel">
                <span class="block">No, cancel</span>
            </QBtn>
            <QBtn Class="@QBtn.Primary" ContentClass="row no-wrap" Disabled="Busy" OnClick="OnConfirm">
                @if (Busy)
                {
                    <i class="q-icon on-left mdi mdi-loading mdi-spin" aria-hidden="true"></i>
                }
                <span class="block">@(Busy ? "Linking…" : "Yes, link this account")</span>
            </QBtn>
        </div>
    </div>
</div>

@code {
    [Parameter] public int PishockUserId { get; set; }
    [Parameter] public IReadOnlyList<string> HubNames { get; set; } = [];
    [Parameter] public string DiscordName { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}

@* Full-viewport Discord auth / boot splash — centered to match the control experience *@
@{
    var pct = Math.Max(0, Math.Min(100, Progress));
}
<div class="auth-boot" role="status" aria-live="polite" aria-busy="@(string.IsNullOrEmpty(Error) ? "true" : "false")">
    <div class="auth-boot__glow" aria-hidden="true"></div>
    <div class="auth-boot__panel">
        <div class="auth-boot__mark" aria-hidden="true">
            <i class="q-icon mdi mdi-flash auth-boot__bolt"></i>
        </div>
        <h1 class="auth-boot__brand auth-boot__brand-row">
            <span class="auth-boot__brand-name">Pi<span>Shock</span></span>
            <AppVersionBadge />
        </h1>
        <p class="auth-boot__sub">Discord Activity</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-boot__error">
                <div class="auth-boot__error-title">Couldn’t connect</div>
                <p>@Error</p>
            </div>
        }
        else
        {
            <div class="auth-boot__bar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct">
                <div class="auth-boot__bar-fill" style="width: @(pct)%"></div>
            </div>
            <div class="auth-boot__meta">
                <span class="auth-boot__label">@Label</span>
                <span class="auth-boot__pct">@(pct)%</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Progress { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Error { get; set; }
}

@implements IDisposable
@inject IJSRuntime Js

@* Persistent header safety strip. Hover-fill opens the full notice; first-time users are forced through it. *@
<div class="official-safety-banner"
     @onmouseenter="() => SetHovering(true)"
     @onmouseleave="() => SetHovering(false)"
     @onfocus="() => SetHovering(true)"
     @onblur="() => SetHovering(false)"
     @onkeydown="OnKeyDown"
     role="button"
     tabindex="0"
     aria-label="Safety notice — hover to open details">
    <div class="row items-center no-wrap justify-center q-gutter-xs" style="position: relative; z-index: 1;">
        <i class="q-icon mdi mdi-shield-alert-outline" aria-hidden="true" style="font-size: 14px;"></i>
        <div class="text-caption ellipsis official-safety-banner__text">
            <strong>Safety notice</strong>
            <span class="official-safety-banner__sep">·</span>
            hover to review warnings
        </div>
    </div>
    <div class="official-safety-banner__fill"
         style="transform: scaleX(@_progress.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))"
         aria-hidden="true"></div>
</div>

@if (_open)
{
    <div class="official-safety-panel @(_blocking ? "official-safety-panel--blocking" : "")"
         role="dialog" aria-modal="@(_blocking ? "true" : "false")" aria-labelledby="safety-notice-title">
        <div class="official-safety-panel__card">
            <div class="row items-center q-gutter-sm q-mb-sm">
                <i class="q-icon mdi mdi-alert text-negative" aria-hidden="true"></i>
                <h2 id="safety-notice-title" class="text-negative text-h6" style="margin: 0;">Safety notice</h2>
            </div>
            <p class="text-body2" style="color: #ffc9c9;">
                This Discord activity can control real electronic shock devices. Read these warnings
                carefully before you continue.
            </p>
            <ul class="official-safety-panel__list">
                @foreach (var point in SafetyPoints)
                {
                    <li>@point</li>
                }
            </ul>
            <div class="row justify-end q-gutter-sm q-mt-md">
                @if (!_blocking)
                {
                    <button type="button" class="q-btn q-btn--outline text-secondary q-btn--rectangle"
                            @onclick="() => _open = false">Close</button>
                }
                <button type="button" class="q-btn q-btn--standard bg-secondary text-dark q-btn--rectangle"
                        @onclick="Confirm">@(_blocking ? "I understand — continue" : "Got it")</button>
            </div>
        </div>
    </div>
}

@code {
    private const string StorageKey = "pishock.safetyNotice.confirmed.v1";
    private const int HoverFillMs = 2200;
    private const int FrameMs = 50;

    private static readonly string[] SafetyPoints =
    [
        "Only use with explicit, informed consent from everyone involved.",
        "Start at the lowest intensity and increase slowly.",
        "Keep emergency STOP reachable and agree on a safe word / release plan.",
        "This controls real electronic shock devices — misuse can cause harm.",
        "Actions in this activity are logged. You are responsible for lawful, safe use.",
    ];

    /// <summary>Force the full warning panel until the user confirms (first-time).</summary>
    [Parameter] public bool ForceOpen { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }

    private bool _open;
    private bool _blocking;
    private bool _hovering;
    private double _progress;
    private CancellationTokenSource? _fill;

    protected override async Task OnInitializedAsync()
    {
        var confirmed = await HasConfirmedAsync();
        if (ForceOpen || !confirmed)
        {
            _open = true;
            _blocking = true;
        }
    }

    private async Task<bool> HasConfirmedAsync()
    {
        try { return await Js.InvokeAsync<string?>("localStorage.getItem", StorageKey) == "1"; }
        catch { return false; }
    }

    private void SetHovering(bool hovering)
    {
        _hovering = hovering;
        if (hovering && !_open && _fill is null)
        {
            _fill = new CancellationTokenSource();
            _ = FillLoopAsync(_fill.Token);
        }
        else if (!hovering)
        {
            StopFill();
            _progress = 0;
        }
    }

    private void StopFill()
    {
        _fill?.Cancel();
        _fill = null;
    }

    private async Task FillLoopAsync(CancellationToken ct)
    {
        var elapsed = 0;
        try
        {
            while (!ct.IsCancellationRequested && _hovering && !_open)
            {
                await Task.Delay(FrameMs, ct);
                elapsed += FrameMs;
                _progress = Math.Min(1, elapsed / (double)HoverFillMs);
                if (_progress >= 1)
                {
                    _open = true;
                    _progress = 0;
                    _fill = null;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") _open = true;
    }

    private async Task Confirm()
    {
        try { await Js.InvokeVoidAsync("localStorage.setItem", StorageKey, "1"); } catch { /* private mode */ }
        _blocking = false;
        _open = false;
        _progress = 0;
        await OnConfirmed.InvokeAsync();
    }

    public void Dispose() => StopFill();
}

    "/api/participants/{targetDiscordUserId}/operate": {
      "post": {
        "operationId": "OperateParticipant",
        "tags": ["Participants"],
        "parameters": [
          {
            "name": "targetDiscordUserId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}

        "parameters": [
          { "name": "linkId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/shares": {
      "post": {
        "operationId": "CreateShare",
        "tags": ["Control"],
        "responses": { "200": { "description": "OK" } }

      "put": {
        "operationId": "SetEmergencyStop",
        "tags": ["Control"],
        "responses": { "200": { "description": "OK" }, "400": { "description": "Bad request" } }
      }
    },
    "/api/operate": {
      "post": {
        "operationId": "Operate",
        "tags": ["Control"],
        "responses": { "200": { "description": "OK" } }

      "post": {
        "operationId": "StartPiShockLogin",
        "tags": ["PiShockSession"],
        "responses": { "200": { "description": "OK" }, "403": { "description": "Consent required" } }
      }
    },
    "/api/pishock/login/status": {
      "get": {
        "operationId": "GetPiShockLoginStatus",
        "tags": ["PiShockSession"],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/pishock/login/confirm": {
      "post": {
        "operationId": "ConfirmPiShockLogin",
        "tags": ["PiShockSession"],
        "responses": { "200": { "description": "OK" }, "404": { "description": "No pending confirm" } }
      }
    },
    "/api/pishock/login/cancel": {
      "post": {
        "operationId": "CancelPiShockLogin",
        "tags": ["PiShockSession"],
        "responses": { "200": { "description": "OK" } }
      }

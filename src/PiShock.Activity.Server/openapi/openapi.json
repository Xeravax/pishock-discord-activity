      "get": {
        "operationId": "ListLogs",
        "tags": ["Control"],
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/broker/status": {
      "get": {
        "operationId": "GetBrokerStatus",
        "tags": ["Control"],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/activity/share": {
      "get": {
        "operationId": "GetActivityShare",
        "tags": ["ActivityShare"],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "operationId": "UpdateActivityShare",
        "tags": ["ActivityShare"],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/activity/settings": {
      "get": {
        "operationId": "GetActivitySettings",
        "tags": ["ActivityShare"],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "operationId": "UpdateActivitySettings",
        "tags": ["ActivityShare"],
        "responses": { "200": { "description": "OK" } }
      }

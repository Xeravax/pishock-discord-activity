{
  "openapi": "3.0.1",
  "info": {
    "title": "PiShock Activity API",
    "version": "1.0.0",
    "description": "Contract stub aligned with Minimal API `.WithName(...)` operationIds. Prefer OpenApiGenerateDocuments output when available."
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "GetHealth",
        "tags": ["Meta"],
        "responses": { "200": { "description": "OK" }, "503": { "description": "Shutting down" } }
      }
    },
    "/api/version": {
      "get": {
        "operationId": "GetVersion",
        "tags": ["Meta"],
        "responses": { "200": { "description": "OK" }, "503": { "description": "Shutting down" } }
      }
    },
    "/api/auth/discord": {
      "post": {
        "operationId": "ExchangeDiscordCode",
        "tags": ["Auth"],
        "responses": { "200": { "description": "OK" }, "400": { "description": "Missing code" } }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "GetMe",
        "tags": ["Auth"],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/consent": {
      "post": {
        "operationId": "AcceptConsent",
        "tags": ["Auth"],
        "responses": { "200": { "description": "OK" }, "400": { "description": "Invalid consent" } }
      },
      "delete": {
        "operationId": "RevokeConsent",
        "tags": ["Auth"],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/announcements": {
      "get": {
        "operationId": "GetAnnouncements",
        "tags": ["Announcements"],
        "responses": { "200": { "description": "OK" }, "502": { "description": "Upstream failure" } }
      }
    },

# Runtime env for docker compose / GHCR image (never commit real secrets).
# Local build:  docker compose up --build -d
# GHCR image:   docker compose -f docker-compose.ghcr.yml --env-file .env up -d
#
# The container refuses to boot if any required variable below is empty.
# CI: set Actions variable DISCORD_CLIENT_ID so the UI build-arg is baked in.

# --- required ---
DATABASE_URL=postgresql://pishock:pishock@db:5432/pishock?schema=public
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# 32-byte AES key for PiShock session tokens (hex or base64)
TOKEN_KEY=
# Public HTTPS URL Discord uses for this activity
PUBLIC_URL=http://localhost:3000

# --- recommended ---
# Bot token for Activity Instance verification (same Discord application)
DISCORD_BOT_TOKEN=
# Application Public Key (hex) — required when REQUIRE_DISCORD_PROXY_AUTH=1
DISCORD_PUBLIC_KEY=

# Proxy signatures on /api/participants/* (defaults on in production unless 0)
REQUIRE_DISCORD_PROXY_AUTH=0

# Host port published by compose (container always listens on 3000)
PORT=3000

# GHCR image override (docker-compose.ghcr.yml)
# PISHOCK_IMAGE=ghcr.io/xeravax/pishock-discord-activity:develop

# Runtime env for docker compose / GHCR image (never commit real secrets).
# Local build:  docker compose up --build -d
# GHCR image:   docker compose -f docker-compose.ghcr.yml --env-file .env up -d
# Optional CI:  set repo Actions variable DISCORD_CLIENT_ID to bake the client id into the UI build.

# Postgres connection string used by Prisma
DATABASE_URL=postgresql://pishock:pishock@db:5432/pishock?schema=public

# Discord application credentials for THIS activity (not PiShock's Discord app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token for Activity Instance verification (same Discord application)
DISCORD_BOT_TOKEN=

# Application Public Key (hex) for optional Discord proxy signature validation
DISCORD_PUBLIC_KEY=

# Set to 1 to require proxy signatures on /api/participants/* (production hardening)
REQUIRE_DISCORD_PROXY_AUTH=0

# 32-byte key for AES-256-GCM encryption of PiShock session tokens (hex or base64)
TOKEN_KEY=

# Public HTTPS URL Discord points at for the activity (e.g. https://activity.example.com)
PUBLIC_URL=http://localhost:3000

# Port the combined UI+API process listens on
PORT=3000

# Optional override when using docker-compose.ghcr.yml
# PISHOCK_IMAGE=ghcr.io/OWNER/pishock-activity:latest

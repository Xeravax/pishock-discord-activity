{
  "name": "pishock-activity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/write-version.mjs",
    "dev": "tsx watch src/server/index.ts",
    "predev:client": "node scripts/write-version.mjs",
    "dev:client": "vite",
    "prebuild": "node scripts/write-version.mjs",
    "build": "prisma generate && vite build && tsc -p tsconfig.server.json && node -e \"require('fs').copyFileSync('src/server.js','dist/server.js'); require('fs').copyFileSync('version.json','dist/version.json'); require('fs').copyFileSync('version.json','client-dist/version.json')\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --import ./test/preload-env.mjs --import tsx --test test/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "version:write": "node scripts/write-version.mjs"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@fastify/static": "^10.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.3",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}

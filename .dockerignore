# git / IDE
.git
.github
.gitignore
.cursor
.vscode
.idea

# env & local secrets (never bake into image)
.env
.env.*
!.env.example
.env.version
version.json

# docs / compose (not needed inside the image build context extras)
README.md
docker-compose*.yml
**/*.md
!prisma/migrations/**/*.sql

# build outputs
**/bin/
**/obj/
TestResults/
sdk-bundle/node_modules/

# local data (repo root only — src/**/Data is EF Core source)
/data
*.db
*.db-journal
*.log
